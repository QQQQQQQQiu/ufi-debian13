#!/bin/bash
# =============================================================================
# UFI103S_V02  (MSM8916 / 512MB RAM / 4GB eMMC)  —— Debian 13 trixie 构建配置
# 所有可调参数集中在这里，脚本只读本文件，不要在脚本里硬编码。
# =============================================================================

# ---------- 目标板 ----------
BOARD="UFI103S_V02"
SOC="msm8916"
ARCH="arm64"

# 设备树（DTB）选择。UFI 系列板子主线用 thwc-ufi001c。
# 若冷启动无 USB / 无热点，依次尝试候选里的其它 DTB（见 docs/排障与救砖.md）。
DTB_NAME="msm8916-thwc-ufi001c"
DTB_CANDIDATES=(
  "msm8916-thwc-ufi001c"   # UFIxxx 系列（UFI103S 首选）
  "msm8916-thwc-uf896"     # UF896 系列，与部分 UFI 板通用
  "msm8916-yiming-uz801v3" # UZ801，最通用，多数 msm8916 棒子能起
  "msm8916-fy-mf800"       # MF800
)

# ---------- Debian ----------
DEBIAN_SUITE="trixie"
DEBIAN_MIRROR="http://deb.debian.org/debian"
DEBIAN_VARIANT="minbase"      # minbase = 最小根文件系统，内存/磁盘占用最低
DEBIAN_COMPONENTS="main,contrib,non-free-firmware"

# ---------- 超频 ----------
# MSM8916 是 28nm，随身WiFi 无散热片。默认 1.4GHz（= Snapdragon 412 官方频点，
# 同芯片不同 SKU 的合法频点，风险最低）。超过此值属激进超频，自负风险。
OC_ENABLE="yes"
OC_MAX_HZ="1401600000"        # 1.4016 GHz
# 留空表示自动继承源码树中最高频点的电压/fuse-level（推荐先跑一次看打印值）
# 例：OC_MICROVOLT="1250000"
OC_MICROVOLT=""
OC_FUSE_LEVEL=""
OC_GOVERNOR="schedutil"       # schedutil / ondemand / performance

# ---------- 4G 基带 ----------
# onboot = 开机自启 ModemManager（常驻约 80-100MB）
# ondemand = 装但不自启，需要时 systemctl start ModemManager（推荐，最省内存）
# none = 完全移除（最省内存，但基带不可用）
MODEM_MODE="ondemand"

# ---------- 内存优化 ----------
ENABLE_ZRAM="yes"
ZRAM_SIZE_PERCENT="60"        # 占物理内存百分比（压缩后实际占用远小于此）
ZRAM_ALGO="lz4"
DISABLE_IPV6=""               # 设成 yes 可再省一点内存和内核模块

# ---------- 内核 ----------
KERNEL_REPO="https://github.com/msm8916-mainline/linux.git"
KERNEL_BRANCH="master"        # 主线最新；想求稳改成某个 tag，如 v6.12
KERNEL_DEFCONFIG="msm8916_defconfig"
KERNEL_LOCALVERSION="-ufi103s"

# ---------- bootchain ----------
LK2ND_REPO="https://github.com/msm8916-mainline/lk2nd.git"
QHYPSTUB_REPO="https://github.com/msm8916-mainline/qhypstub.git"
QTESTSIGN_REPO="https://github.com/msm8916-mainline/qtestsign.git"
LK2ND_DTB="msm8916-512mb-mtp"

# ---------- 高通固件（sbl1/rpm/tz/modem/wcnss 等） ----------
# 从原厂备份里提取；没有的话从 Linaro 的 8916 固件包下载（WiFi/-modem 可能不匹配）
FIRMWARE_URL="https://releases.linaro.org/96boards/dragonboard410c/linaro/firmware/"

# ---------- 路径 ----------
WORKDIR="${WORKDIR:-$PWD}"
SRCDIR="$WORKDIR/src"
BUILDDIR="$WORKDIR/build"
ROOTFSDIR="$WORKDIR/rootfs"
FILESDIR="$WORKDIR/files"
BACKUPDIR="$WORKDIR/backup"

# ---------- 默认凭据（首次启动后务必修改！） ----------
HOSTNAME="ufi103s"
USERNAME="user"
PASSWORD="1"
WIFI_SSID="UFI-DEBIAN"
WIFI_PSK="12345678"
USB_GW_IP="192.168.68.1/24"   # USB RNDIS 网关
WIFI_GW_IP="10.42.0.1/24"     # WiFi AP 网关

# ---------- 构建并发 ----------
JOBS="$(nproc)"
