# =============================================================================
# UFI103S 内核配置片段 —— 低内存 + USB gadget + 4G 基带 + WiFi
# 用法：scripts/kconfig/merge_config.sh arch/arm64/configs/msm8916_defconfig \
#         ../../kernel-fragments/ufi-lowmem.config
# =============================================================================

# ---------- USB Gadget：RNDIS(USB网卡) + ADB(FunctionFS) 复合 ----------
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_MASS_STORAGE=y
CONFIG_USB_FUNCTIONFS=y
CONFIG_USB_FUNCTIONFS_ETH=y
CONFIG_USB_FUNCTIONFS_GENERIC=y
CONFIG_USB_F_RNDIS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_RNDIS=y
CONFIG_USB_CONFIGFS_F_ECM=y
CONFIG_USB_CONFIGFS_F_NCM=y
CONFIG_USB_CONFIGFS_F_MASS_STORAGE=y
CONFIG_USB_CONFIGFS_F_HID=y

# ---------- 内存压缩：512MB 机器的救命稻草 ----------
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZRAM_COMP_ZSTD=y
CONFIG_ZRAM_COMP_LZ4=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZSMALLOC_STAT=n
CONFIG_SWAP=y

# ---------- 4G 基带（ModemManager / QRTR / QMI / remoteproc） ----------
CONFIG_REMOTEPROC=n
CONFIG_QCOM_RPROC_COMMON=n
CONFIG_QCOM_Q6V5_COMMON=n
CONFIG_QCOM_Q6V5_MSS=n
CONFIG_QCOM_Q6V5_PAS=n
CONFIG_QCOM_WCNSS_PIL=n
CONFIG_QCOM_RMTFS_MEM=n
CONFIG_QRTR=n
CONFIG_QRTR_SMD=n
CONFIG_QRTR_TUN=n
CONFIG_QCOM_SMD_RPM=n
CONFIG_QCOM_SMEM=n
CONFIG_QCOM_SMP2P=n
CONFIG_QCOM_SMSM=n
CONFIG_RPMSG_CHAR=n
CONFIG_RPMSG_QCOM_GLINK_SMEM=n
CONFIG_RPMSG_QCOM_SMD=n
CONFIG_QCOM_IPC=n
CONFIG_QCOM_GLINK_SSR=n
CONFIG_QCOM_QMI_HELPERS=n

# ---------- WiFi：UFI 板多为 WCN3620 over SDIO ----------
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WCN36XX=y
CONFIG_WCN36XX_SDIO=y
CONFIG_ATH_COMMON=y

# ---------- CPU 调频 ----------
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_DT=y
CONFIG_ARM_QCOM_CPUFREQ_NVMEM=y
CONFIG_QCOM_CPR=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_SPM=y

# ---------- 省内存：关掉用不上的调试与统计 ----------
CONFIG_SLUB_DEBUG=n
CONFIG_DEBUG_KERNEL=n
CONFIG_DEBUG_INFO=n
CONFIG_DEBUG_INFO_DWARF5=n
CONFIG_DEBUG_FS_DISALLOW_INT=y
CONFIG_SCHED_DEBUG=n
CONFIG_FTRACE=n
CONFIG_FUNCTION_TRACER=n
CONFIG_TRACE_IRQFLAGS=n
CONFIG_KALLSYMS_ALL=n
CONFIG_PROFILING=n
CONFIG_KPROBES=n
CONFIG_UPROBES=n
CONFIG_PERF_EVENTS=n
CONFIG_HAVE_PERF_EVENTS=n
CONFIG_MEMCG=n
CONFIG_CGROUP_MEM_RES_CTLR=n

# 透明大页在 512MB 上只会造成内存碎片与卡顿
CONFIG_TRANSPARENT_HUGEPAGE=n
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=n

# ---------- eMMC / 文件系统 ----------
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT2_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_SQUASHFS=n

# ---------- 串口调试（UART，UFI 板为 3.3V 电平） ----------
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_SERIAL_DEV_BUS=y

# ---------- 网络 ----------
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_INET=y
CONFIG_NET_SCHED=n

# ---------- 其它 ----------
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_NEW_LEDS=y
CONFIG_GPIO_SYSFS=n
CONFIG_THERMAL=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_QCOM_TSENS=y
CONFIG_DEVMEM=y
CONFIG_UNIX=y
CONFIG_TUN=y
CONFIG_BRIDGE_VLAN_FILTERING=n
