#!/bin/sh
# =============================================================================
# UFI103S USB 复合 Gadget：RNDIS(usb0 网卡) + ADB(FunctionFS)
#
# 顺序不能乱：必须先挂好 FunctionFS 并让 adbd 打开 ep0，最后才能绑 UDC。
# 提前绑 UDC 会导致主机枚举出一个没有 adb 接口的残缺设备。
# =============================================================================
CONFIGFS=/sys/kernel/config
GADGET=$CONFIGFS/usb_gadget/ufi
FFS_DIR=/dev/usb-ffs/adb

setup() {
    modprobe libcomposite 2>/dev/null || true
    modprobe usb_f_fs 2>/dev/null || true

    mountpoint -q $CONFIGFS || mount -t configfs none $CONFIGFS

    if [ ! -f "$GADGET/idVendor" ]; then
        mkdir -p "$GADGET"
        echo 0x1d6b > "$GADGET/idVendor"   # Linux Foundation
        echo 0x0104 > "$GADGET/idProduct"  # Multifunction Composite Gadget
        echo 0x0100 > "$GADGET/bcdDevice"
        echo 0x0200 > "$GADGET/bcdUSB"

        mkdir -p "$GADGET/strings/0x409"
        echo "UFI103S"        > "$GADGET/strings/0x409/manufacturer"
        echo "Debian13 Stick" > "$GADGET/strings/0x409/product"
        echo "ufi103s0001"    > "$GADGET/strings/0x409/serialnumber"

        mkdir -p "$GADGET/configs/c.1/strings/0x409"
        echo "RNDIS+ADB" > "$GADGET/configs/c.1/strings/0x409/configuration"
        echo 500        > "$GADGET/configs/c.1/MaxPower"
        echo 0x80       > "$GADGET/configs/c.1/bmAttributes"

        # --- 功能 1：RNDIS（USB 网卡，主机上出现 usb0）---
        mkdir -p "$GADGET/functions/rndis.usb0"
        # Windows 需要这几个 class code 才会加载 RNDIS 驱动
        echo 0x02 > "$GADGET/functions/rndis.usb0/class"
        echo 0x02 > "$GADGET/functions/rndis.usb0/subclass"
        echo 0xff > "$GADGET/functions/rndis.usb0/protocol"

        # --- 功能 2：ADB over FunctionFS ---
        mkdir -p "$GADGET/functions/ffs.adb"

        ln -sf "$GADGET/functions/rndis.usb0" "$GADGET/configs/c.1/rndis.usb0"
        ln -sf "$GADGET/functions/ffs.adb"    "$GADGET/configs/c.1/ffs.adb"
    fi

    # FunctionFS 必须以 uid/gid 2000 挂载：adbd 启动后会降权到 AID_SHELL(2000)，
    # 否则打不开 ep0，会静默退化成只监听 TCP，USB 侧永远枚举不出 adb。
    mkdir -p "$FFS_DIR"
    mountpoint -q "$FFS_DIR" || mount -t functionfs -o uid=2000,gid=2000 adb "$FFS_DIR"
}

bind_udc() {
    # 等 adbd 建好 ep1/ep2 再绑 UDC，最多等 15 秒
    i=0
    while [ $i -lt 30 ]; do
        [ -e "$FFS_DIR/ep1" ] && break
        i=$((i+1)); sleep 0.5
    done
    UDC=$(ls /sys/class/udc/ 2>/dev/null | head -1)
    [ -z "$UDC" ] && { echo "ufi-usb-gadget: 无可用 UDC" >&2; exit 1; }
    echo ""      > "$GADGET/UDC" 2>/dev/null || true
    echo "$UDC"  > "$GADGET/UDC" 2>/dev/null || true
    echo "ufi-usb-gadget: bound to $UDC"
}

reset() {
    if [ -d "$GADGET" ]; then
        echo "" > "$GADGET/UDC" 2>/dev/null || true
        umount "$FFS_DIR" 2>/dev/null || true
    fi
}

case "$1" in
    setup)    setup ;;
    bind)     bind_udc ;;
    reset)    reset ;;
    *) echo "用法: $0 {setup|bind|reset}" >&2; exit 1 ;;
esac
